rules_version = '2';
// Cinema: only the two invited Google accounts can read; the admin writes anything,
// the viewer may only add or remove "Want to watch" entries on the shared list.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin()  { return signedIn() && request.auth.token.email == 'ADMIN_EMAIL'; }
    function isViewer() { return signedIn() && request.auth.token.email == 'VIEWER_EMAIL'; }

    match /shared/{doc} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
    }

    match /verdicts/{id} {
      allow read: if isAdmin() || isViewer();
      allow write: if isAdmin();
      allow create: if isViewer() && request.resource.data.status == 'watchlist';
      allow update: if isViewer() && resource.data.status == 'watchlist' && request.resource.data.status == 'watchlist';
      allow delete: if isViewer() && resource.data.status == 'watchlist';
    }

    match /{other=**} {
      allow read, write: if false;
    }
  }
}
